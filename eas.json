{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.2",
      "pnpm": "10.34.6"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "development", "EXPO_NO_DOTENV": "1" },
      "ios": { "simulator": true }
    },
    "staging": {
      "extends": "base",
      "distribution": "internal",
      "channel": "staging",
      "env": { "APP_ENV": "staging", "EXPO_NO_DOTENV": "1" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_ENV": "production", "EXPO_NO_DOTENV": "1" }
    }
  },
  "submit": {
    "production": {}
  }
}
