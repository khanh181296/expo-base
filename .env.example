# Copy to .env.development / .env.staging / .env.production
API_URL=https://api.example.com
API_TIMEOUT_MS=15000
# Serve /auth/* from the in-app mock adapter (development only)
USE_MOCK_API=false

# Crash reporting. Empty disables Sentry. Development builds never send events.
SENTRY_DSN=

# Build-time only (not shipped in the JS bundle)
EAS_PROJECT_ID=
EXPO_ACCOUNT_OWNER=
SENTRY_ORG=
SENTRY_PROJECT=
# Firebase (optional). Download from the Firebase console; one Firebase app per environment.
# Locally: paths like ./firebase/dev/google-services.json (git-ignored). On EAS: file env vars.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=

# Social sign-in (needs Firebase above). Client IDs come from the Firebase / Google Cloud console.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# true after enabling "Sign in with Apple" for the bundle ID in Apple Developer + Firebase
APPLE_SIGN_IN=false
# SENTRY_AUTH_TOKEN uploads source maps. Set it as an EAS secret, never in these files.
